      "key": "AdminOnly",
      "kind": "boolean",
      "tier": "advanced",
      "default": false,
      "es": {
        "label": "Solo administradores",
        "description": "Solo los admins pueden usar el buscador."
      },
      "en": {
        "label": "Admins only",
        "description": "Only admins can use the finder."
      }
    },
