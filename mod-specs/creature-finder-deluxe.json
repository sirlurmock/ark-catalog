      "key": "FindAllCreatures",
      "kind": "boolean",
      "tier": "basic",
      "default": true,
      "es": {
        "label": "Encontrar todas las criaturas",
        "description": "El buscador lista todas las criaturas del mapa. Apagalo para restringir qué se puede encontrar."
      },
      "en": {
        "label": "Find all creatures",
        "description": "The finder lists every creature on the map. Turn it off to restrict what can be found."
      }
    },
    {
      "key": "ShowOnlyTamed",
      "kind": "boolean",
      "tier": "basic",
      "default": false,
      "es": {
        "label": "Mostrar solo domesticados",
        "description": "El buscador solo muestra criaturas tameadas — útil para encontrar a tu dino perdido sin spoilear los spawns salvajes."
      },
      "en": {
        "label": "Show only tamed",
        "description": "The finder only shows tamed creatures — useful to find your lost dino without spoiling wild spawns."
      }
    },
    {
      "key": "CreatureClassRequired",
      "kind": "boolean",
      "tier": "advanced",
      "default": false,
      "es": {
        "label": "Exigir la clase exacta",
        "description": "Para buscar hay que especificar la clase exacta de la criatura en vez de elegir de la lista."
      },
      "en": {
        "label": "Require exact class",
        "description": "Searching requires specifying the creature's exact class instead of picking from the list."
      }
    },
